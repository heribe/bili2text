# bili2text 系统的全局访问解锁密码（默认为 bili123）
ACCESS_PASSWORD=bili123

# Groq Cloud API 秘钥（用于 Whisper 语音转录，申请地址：https://console.groq.com/）
GROQ_API_KEY=gsk_your_groq_api_key_here

# LongCat API 秘钥（用于角色分离与合并排版，申请地址：https://api.longcat.chat/）
LONGCAT_API_KEY=your_longcat_api_key_here

# -------------------- 网络代理与中转配置 (选填) --------------------
# 代理配置：若服务器在国内且无法直连 Groq/LongCat，可配置全局代理（支持 HTTP/HTTPS 代理）
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 自定义 API 端点：若使用中转/代理接口，可修改为对应的中转域名
# GROQ_API_BASE=https://api.groq.com
# LONGCAT_API_BASE=https://api.longcat.chat

